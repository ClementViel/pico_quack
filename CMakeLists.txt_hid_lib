if (NOT TARGET hid_pass)
add_library(hid_pass INTERFACE)


target_sources(hid_pass INTERFACE
    hid_passthrough.c
    # PIO-USB HCD/DCD implementation for TinyUSB
    ${PICO_TINYUSB_PATH}/src/portable/raspberrypi/pio_usb/dcd_pio_usb.c
    ${PICO_TINYUSB_PATH}/src/portable/raspberrypi/pio_usb/hcd_pio_usb.c
)

add_subdirectory(pio_usb)
add_subdirectory(cdc_stdio_lib)

target_link_libraries(hid_pass INTERFACE
    pico_stdlib
    pico_multicore
    hardware_clocks
    pico_pio_usb
    tinyusb_device
    tinyusb_host
    cdc_stdio_lib
)

target_include_directories(hid_pass INTERFACE
    ${CMAKE_CURRENT_LIST_DIR}
)

# Use TinyUSB implementation for PIO-USB
target_compile_definitions(hid_pass INTERFACE
    PIO_USB_USE_TINYUSB
    PICO_DEFAULT_UART_BAUD_RATE=115200
)
endif()
